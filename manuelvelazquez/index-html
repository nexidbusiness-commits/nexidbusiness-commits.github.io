<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111111">

  <title>Manuel Velazquez | Óptica Evan's</title>

  <style>
    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }

    :root{
      --primary:#111111;
      --secondary:#292929;
      --accent:#555555;
      --light:#f5f5f5;
      --white:#ffffff;
      --text:#1c1c1c;
      --muted:#707070;
    }

    body{
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
      background:#ffffff;
      color:var(--text);
      line-height:1.5;
    }

    main{
      width:100%;
      overflow:hidden;
    }

    /* HERO */

    .hero{
      position:relative;
      min-height:430px;
      background:
        radial-gradient(circle at 85% 15%, rgba(255,255,255,.08), transparent 28%),
        linear-gradient(145deg,#090909 0%,#202020 55%,#090909 100%);
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      text-align:center;
      padding:55px 25px 50px;
      color:#fff;
      overflow:hidden;
    }

    .hero::before{
      content:"";
      position:absolute;
      width:320px;
      height:320px;
      border:1px solid rgba(255,255,255,.08);
      border-radius:50%;
      top:-190px;
      right:-100px;
    }

    .hero::after{
      content:"";
      position:absolute;
      width:220px;
      height:220px;
      border:1px solid rgba(255,255,255,.05);
      transform:rotate(45deg);
      left:-140px;
      bottom:-130px;
    }

    .logo-wrap{
      position:relative;
      z-index:2;
      width:150px;
      height:150px;
      background:#fff;
      border-radius:24px;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:15px;
      margin-bottom:27px;
      box-shadow:0 18px 45px rgba(0,0,0,.28);
    }

    .logo-wrap img{
      width:100%;
      height:100%;
      object-fit:contain;
      border-radius:14px;
    }

    .eyebrow{
      position:relative;
      z-index:2;
      font-size:11px;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:2.5px;
      opacity:.72;
      margin-bottom:9px;
    }

    .hero h1{
      position:relative;
      z-index:2;
      font-size:34px;
      line-height:1.1;
      font-weight:750;
      margin-bottom:9px;
    }

    .hero .role{
      position:relative;
      z-index:2;
      font-size:15px;
      color:rgba(255,255,255,.78);
      font-weight:500;
    }

    /* INTRO */

    .intro{
      max-width:650px;
      margin:auto;
      padding:50px 25px 22px;
      text-align:center;
    }

    .section-label{
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:2.4px;
      color:var(--muted);
      margin-bottom:12px;
    }

    .intro h2{
      font-size:27px;
      line-height:1.2;
      margin-bottom:14px;
      color:#111;
    }

    .intro p{
      max-width:510px;
      margin:auto;
      font-size:14px;
      color:#707070;
      line-height:1.7;
    }

    /* BOTONES */

    .actions{
      max-width:590px;
      margin:auto;
      padding:24px 22px 55px;
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:13px;
    }

    .action{
      text-decoration:none;
      background:#fff;
      color:#161616;
      min-height:105px;
      border:1px solid #e6e6e6;
      border-radius:20px;
      padding:19px 13px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      text-align:center;
      box-shadow:0 7px 22px rgba(0,0,0,.055);
      transition:.2s ease;
    }

    .action:active{
      transform:scale(.97);
    }

    .icon{
      width:43px;
      height:43px;
      border-radius:50%;
      background:#111;
      color:#fff;
      display:flex;
      align-items:center;
      justify-content:center;
      margin-bottom:9px;
      font-size:19px;
      font-weight:700;
    }

    .action span{
      font-size:12px;
      font-weight:750;
    }

    /* BLOQUE PROFESIONAL */

    .professional{
      background:#f5f5f5;
      padding:55px 25px;
    }

    .professional-inner{
      max-width:600px;
      margin:auto;
    }

    .professional .small{
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:2px;
      color:#777;
      margin-bottom:12px;
    }

    .professional h3{
      font-size:25px;
      line-height:1.25;
      color:#111;
      margin-bottom:15px;
    }

    .professional p{
      font-size:14px;
      line-height:1.7;
      color:#696969;
    }

    /* DATOS */

    .details{
      max-width:600px;
      margin:auto;
      padding:48px 25px 55px;
    }

    .detail{
      padding:19px 0;
      border-bottom:1px solid #ececec;
    }

    .detail:last-child{
      border-bottom:none;
    }

    .detail-label{
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:1.8px;
      color:#999;
      margin-bottom:5px;
    }

    .detail-value{
      font-size:15px;
      font-weight:650;
      color:#222;
    }

    /* FIRMA NEXID MAESTRA */

    .nexid-brand{
      position:relative;
      overflow:hidden;
      padding:53px 25px 31px;
      background:#03182b;
      text-align:center;
    }

    .nexid-brand::before{
      content:"";
      position:absolute;
      width:280px;
      height:280px;
      border:1px solid rgba(40,167,237,.11);
      border-radius:50%;
      top:-180px;
      left:50%;
      transform:translateX(-50%);
    }

    .nexid-brand::after{
      content:"";
      position:absolute;
      width:190px;
      height:190px;
      border:1px solid rgba(255,255,255,.055);
      transform:rotate(45deg);
      right:-130px;
      bottom:-125px;
    }

    .nexid-lines{
      position:absolute;
      inset:0;
      opacity:.07;
      background-image:
        linear-gradient(90deg,transparent 49%,#48b4ef 50%,transparent 51%);
      background-size:33px 100%;
    }

    .nexid-watermark{
      position:absolute;
      width:430px;
      max-width:none;
      left:50%;
      top:50%;
      transform:translate(-50%,-50%);
      opacity:.035;
      filter:grayscale(1);
    }

    .powered{
      position:relative;
      z-index:3;
      display:block;
      width:285px;
      max-width:88%;
      height:auto;
      margin:0 auto;
      border-radius:10px;
      box-shadow:0 12px 35px rgba(0,0,0,.22);
    }

    .created{
      position:relative;
      z-index:3;
      margin-top:17px;
      color:rgba(255,255,255,.42);
      font-size:9px;
      font-weight:600;
      letter-spacing:1.8px;
      text-transform:uppercase;
    }

    @media(max-width:380px){
      .hero h1{
        font-size:30px;
      }

      .actions{
        padding-left:17px;
        padding-right:17px;
        gap:10px;
      }
    }
  </style>
</head>

<body>

<main>

  <section class="hero">

    <div class="logo-wrap">
